#!/bin/sh

board="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
memtotal_kb="$(awk '/MemTotal:/ { print $2; exit }' /proc/meminfo 2>/dev/null)"

case "$board" in
redmi,ax3000|xiaomi,cr881x|cmcc,rax3000q)
	[ -n "$memtotal_kb" ] || memtotal_kb=262144
	zram_size_mb="$((memtotal_kb / 1024))"
	[ "$zram_size_mb" -gt 0 ] || zram_size_mb=256

	uci -q batch <<-EOF
		set system.@system[0].zram_size_mb='${zram_size_mb}'
		set system.@system[0].zram_comp_algo='lzo'
		set system.@system[0].zram_priority='100'
		commit system
	EOF

	/etc/init.d/zram enable >/dev/null 2>&1
	;;
esac

exit 0
